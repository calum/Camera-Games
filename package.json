{
  "name": "kids-camera-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Webcam-controlled movement game for kids",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=240000 \"test/e2e/*.test.js\"",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "puppeteer-core": "^25.14.0"
  }
}
