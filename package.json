{
  "name": "camera-games",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Webcam-controlled movement game for kids",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test \"test/unit/*.test.js\"",
    "typecheck": "tsc -p jsconfig.json",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=900000 \"test/e2e/*.test.js\"",
    "test:perf": "node --test --test-timeout=900000 test/e2e/performance.e2e.test.js",
    "test:all": "npm run typecheck && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "puppeteer-core": "^25.14.0",
    "typescript": "^7.0.2"
  }
}
